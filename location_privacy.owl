<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/privacy.owl#"
    xml:base="http://example.org/privacy.owl"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    
    <owl:Ontology rdf:about=""/>
    
    <owl:Class rdf:about="#User"/>
    <owl:Class rdf:about="#OptIn"/>
    <owl:Class rdf:about="#OptOut"/>
    
    <owl:ObjectProperty rdf:about="#HasPrivacySetting">
        <rdfs:domain rdf:resource="#User"/>
        <rdfs:range rdf:resource="#OptIn"/>
        <rdfs:range rdf:resource="#OptOut"/>
    </owl:ObjectProperty>
</rdf:RDF>
