@prefix : <http://example.org/privacy.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/privacy.owl> a owl:Ontology .

:Alice a :User,
        owl:NamedIndividual ;
    :HasPrivacySetting :OptOut .

:Bob a :User,
        owl:NamedIndividual ;
    :HasPrivacySetting :OptOut .

:Bus a owl:Class ;
    rdfs:subClassOf owl:Thing .

:HasPrivacySetting a owl:ObjectProperty ;
    rdfs:domain :User ;
    rdfs:range owl:Thing .

:optin1 a :OptIn,
        owl:NamedIndividual .

:optout1 a :OptOut,
        owl:NamedIndividual .

:OptIn a owl:Class ;
    rdfs:subClassOf owl:Thing .

:OptOut a owl:Class ;
    rdfs:subClassOf owl:Thing .

:User a owl:Class ;
    rdfs:subClassOf owl:Thing .

